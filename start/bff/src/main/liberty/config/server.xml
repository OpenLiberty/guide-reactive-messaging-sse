<server description="BFF">

  <featureManager>
    <platform>jakartaee-10.0</platform>
    <platform>microprofile-7.0</platform>
    <feature>beanValidation</feature>
    <feature>jsonb</feature>
    <feature>cdi</feature>
    <feature>mpOpenAPI</feature>
    <feature>mpRestClient</feature>
    <feature>mpHealth</feature>
    <!-- tag::featureMP[] -->
    <feature>mpReactiveMessaging</feature>
    <!-- end::featureMP[] -->
  </featureManager>

  <variable name="http.port" defaultValue="9084"/>
  <variable name="https.port" defaultValue="9444"/>

  <httpEndpoint
    host="*"
    httpPort="${http.port}"
    httpsPort="${https.port}"
    id="defaultHttpEndpoint"
  />

  <cors domain="/bff/sse"
      allowedOrigins="*"
      allowedMethods="GET"
      allowedHeaders="accept"
      exposeHeaders=""
      allowCredentials="true"
      maxAge="3600" />

  <webApplication location="bff.war" contextRoot="/"/>
</server>
